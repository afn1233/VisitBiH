# PostgreSQL connection string (matches docker-compose.yml defaults)
#DATABASE_URL=postgresql://visitbih:visitbih@localhost:5432/visitbih
DATABASE_URL=jdbc:postgresql://localhost:5432/visitbih
# JWT signing secret - generate a real random value for anything beyond local dev
# e.g. `python -c "import secrets; print(secrets.token_hex(32))"`
JWT_SECRET=change-me-to-a-random-secret
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080

# Origin the frontend is served from, for CORS
FRONTEND_ORIGIN=http://localhost:5173

# n8n integration - link reachability/preview enrichment (see README "n8n setup")
# Leave N8N_WEBHOOK_URL blank to disable enrichment entirely; links just stay "pending".
N8N_WEBHOOK_URL=http://localhost:5678/webhook/link-check
LINK_ENRICHMENT_API_KEY=change-me-to-a-random-secret

# n8n editor login (docker-compose.yml reads these via ${...} - nothing sensitive stays in that tracked file)
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=change-me

# "Ask your links" (RAG) - see README "Ask your links". Leave blank to disable;
# links are just saved without an embedding and /ask returns a clear error.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
