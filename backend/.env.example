# PostgreSQL connection string (matches docker-compose.yml defaults)
DATABASE_URL=postgresql://visitbih:visitbih@localhost:5432/visitbih

# JWT signing secret - generate a real random value for anything beyond local dev
# e.g. `python -c "import secrets; print(secrets.token_hex(32))"`
JWT_SECRET=change-me-to-a-random-secret
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080

# Origin the frontend is served from, for CORS
FRONTEND_ORIGIN=http://localhost:5173
